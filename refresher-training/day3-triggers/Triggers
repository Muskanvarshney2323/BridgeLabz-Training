    PatientID INT,
    PatientName VARCHAR(50),
    Age INT,
    Gender CHAR(1),
    MobileNo VARCHAR(15),
    ActionType VARCHAR(10),
    ActionDate DATETIME DEFAULT GETDATE()
);
GO

--patient after insert trigger
