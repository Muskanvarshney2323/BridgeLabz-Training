--audit table
CREATE TABLE Doctors_Audit
(
    AuditID INT IDENTITY(1,1) PRIMARY KEY,
    DoctorID INT,
    DoctorName VARCHAR(50),
    Expertise VARCHAR(50),
    ContactNo VARCHAR(15),
    ActionType VARCHAR(10),
    ActionDate DATETIME DEFAULT GETDATE()
);
GO
--after insert(Whenever a new doctor is added...the trigger stores the details in the audit table)
CREATE TRIGGER trg_Doctors_Insert
ON Doctor
AFTER INSERT
AS
BEGIN
    INSERT INTO Doctors_Audit
    (
        DoctorID,
        DoctorName,
        Expertise,
        ContactNo,
        ActionType
    )
    SELECT
        DoctorID,
        DoctorName,
        Expertise,
        ContactNo,
        'INSERT'
    FROM inserted;
END;
GO
--after update(Whenever a doctor's details are updated...the new values are stored)
CREATE TRIGGER trg_Doctors_Update
ON Doctor
AFTER UPDATE
AS
BEGIN
    INSERT INTO Doctors_Audit
    (
        DoctorID,
        DoctorName,
        Expertise,
        ContactNo,
        ActionType
    )
    SELECT
        DoctorID,
        DoctorName,
        Expertise,
        ContactNo,
        'UPDATE'
    FROM inserted;
END;
GO
--after delete(Whenever a doctor is deleted...the old values are stored)
CREATE TRIGGER trg_Doctors_Delete
ON Doctor
AFTER DELETE
AS
BEGIN
    INSERT INTO Doctors_Audit
    (
        DoctorID,
        DoctorName,
        Expertise,
        ContactNo,
        ActionType
    )
    SELECT
        DoctorID,
        DoctorName,
        Expertise,
        ContactNo,
        'DELETE'
    FROM deleted;
END;
